#!/bin/sh
# Runs the whole of the tests before a push, since the push itself checks
# only the quick basics. Switch it on once with `npm run hooks`; skip it for
# one push with `git push --no-verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "Running the unit and browser tests before pushing (git push --no-verify skips them)…"
npm run --silent check
